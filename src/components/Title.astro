---
interface Props {
  title: string;
  subtitle?: string;
  text?: string;
}

const { title, subtitle, text } = Astro.props;
---

<div class="title-wrapper">
  <h1>
    {title}
    {subtitle && <p class="subtitle-wrapper">{subtitle}</p>}
  </h1>
  <div class="text">
    <p>{text}</p>
  </div>
</div>

<style>
@font-face {
  font-family: "AuroraFont";
  src: url("/fonts/Rosehot.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "OlsenFont";
  src: url("/fonts/AstonScript.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}




  .title-wrapper {
  position: relative;
  height: 500px;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
  text-align: center;
  color: white;
  pointer-events: none;
  }

  h1 {
  position: relative;
  display: inline-block; /* 🔑 CLAVE */
  font-family: "AuroraFont", sans-serif;
  font-size: 5rem;
  margin: 0;
  }

 .text{
  position: fixed;          /* 🔑 CLAVE */
  inset: 0;                 /* top/right/bottom/left = 0 */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
  pointer-events: none;
  font-family: sans-serif;
 }

  p {
    text-align: center;
    opacity: 0.8;
    margin-top: 0.5rem;

  }

  .subtitle-wrapper{
  position: absolute;
  right: -1rem;        
  bottom: -2.5rem;
  font-family: "OlsenFont", sans-serif;
  font-size: 1rem;
  opacity: 0.85;
  white-space: nowrap;
  }
</style>
