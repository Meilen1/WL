---
import Aurora from "../components/Aurora.astro";
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Title from "../components/Title.astro";
import Quiz from "../components/Quiz";
---

<Layout>
  <Aurora />

  <Title
    title="AURORA"
    subtitle="Olsen"
    text="Whitelist muy pronto, 25 de Enero 2026 a las 00hs"
  />


  <div id="quiz-root"></div>
</Layout>

<script type="module">
  import { mount } from "astro/client";

  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("startTyping");
    const quizRoot = document.getElementById("quiz-root");

    if (!btn || !quizRoot) return;

    btn.addEventListener("click", async () => {
      if (quizRoot.dataset.mounted) return;
      quizRoot.dataset.mounted = "true";

      const { default: Quiz } = await import("../components/Quiz.tsx");

      mount(Quiz, {
        target: quizRoot,
      });
    });
  });
</script>
